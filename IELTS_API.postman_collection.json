{
	"info": {
		"_postman_id": "ielts-api-collection",
		"name": "IELTS API Collection",
		"description": "Complete API collection for IELTS exam system",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User Routes",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": ["{{base_url}}"],
							"path": ["api", "register"]
						}
					}
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.accessToken) {",
									"        pm.environment.set('access_token', jsonData.data.accessToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "profile"]
						}
					}
				}
			]
		},
		{
			"name": "Profile Routes",
			"item": [
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "profile"]
						}
					}
				},
				{
					"name": "Update Profile (Bio + Avatar)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "bio",
									"value": "My updated bio text",
									"type": "text"
								},
								{
									"key": "avatar",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": ["{{base_url}}"],
							"path": ["api", "profile"]
						}
					}
				},
				{
					"name": "Update Bio Only",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bio\": \"My new bio text here\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/profile/bio",
							"host": ["{{base_url}}"],
							"path": ["api", "profile", "bio"]
						}
					}
				},
				{
					"name": "Upload Avatar Only",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "avatar",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/profile/avatar",
							"host": ["{{base_url}}"],
							"path": ["api", "profile", "avatar"]
						}
					}
				}
			]
		},
		{
			"name": "Exam Routes",
			"item": [
				{
					"name": "Get All Exams (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/exams",
							"host": ["{{base_url}}"],
							"path": ["api", "exams"]
						}
					}
				},
				{
					"name": "Get Exam by ID (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/exams/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "exam-uuid-here"
								}
							]
						}
					}
				},
				{
					"name": "Create Exam",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.environment.set('exam_id', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"exam_type\": \"Task 1\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/exams",
							"host": ["{{base_url}}"],
							"path": ["api", "exams"]
						}
					}
				},
				{
					"name": "Start Exam",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.environment.set('user_exam_id', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"exam_id\": \"{{exam_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/exams/start",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", "start"]
						}
					}
				},
				{
					"name": "Submit Answer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_exam_id\": \"{{user_exam_id}}\",\n  \"question_id\": \"question-uuid-here\",\n  \"answer_text\": \"My answer to this question...\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/exams/submit-answer",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", "submit-answer"]
						}
					}
				},
				{
					"name": "Complete Exam",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_exam_id\": \"{{user_exam_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/exams/complete",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", "complete"]
						}
					}
				},
				{
					"name": "Get All User Exams",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/exams/user/my-exams",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", "user", "my-exams"]
						}
					}
				},
				{
					"name": "Get User Exam with Answers",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/exams/user/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "exams", "user", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{user_exam_id}}"
								}
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000"
		},
		{
			"key": "access_token",
			"value": ""
		},
		{
			"key": "exam_id",
			"value": ""
		},
		{
			"key": "user_exam_id",
			"value": ""
		}
	]
}

